[gd_scene format=3]

[ext_resource type="Script" path="res://ui/objective_panel.gd" id="1"]
[ext_resource type="StyleBox" path="res://ui/white_panel.tres" id="2"]

[sub_resource type="FontVariation" id="FontVariation_bold"]
variation_embolden = 0.8

[node name="ObjectivePanel" type="CanvasLayer"]
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
grow_horizontal = 0
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 12

[node name="Panel" type="PanelContainer" parent="Margin"]
custom_minimum_size = Vector2(200, 0)
theme_override_styles/panel = ExtResource("2")

[node name="Column" type="VBoxContainer" parent="Margin/Panel"]
theme_override_constants/separation = 6

[node name="Heading" type="Label" parent="Margin/Panel/Column"]
theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_fonts/font = SubResource("FontVariation_bold")
text = "OBJECTIVE"

[node name="Goal" type="Label" parent="Margin/Panel/Column"]
unique_name_in_owner = true
theme_override_colors/font_color = Color(0, 0, 0, 1)
text = "Reach the exit"
